# Base URL of the SRRI service (backend/api).
#
# Copy this file to .env.local and adjust if needed. Vite only reads env files
# at startup, so restart `npm run dev` after creating it.
#
# Start the service with:
#   cd backend/api && ../.venv/bin/uvicorn main:app --reload --port 8000
VITE_API_URL=http://localhost:8000
